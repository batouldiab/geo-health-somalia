# Build the frontend, then serve it (plus the datasets and the speech model) with Nginx.
# Build context is the repo root:  docker build -f deploy/Dockerfile.nginx .

FROM node:26-alpine AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
# onnxruntime-node's postinstall fetches GPU binaries the browser build never uses
RUN npm ci --no-fund --no-audit --ignore-scripts
COPY frontend ./
COPY data ../data
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/geo-health.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
# dist/ already carries data/ (vite.config.ts copyData) and public/models, public/ort
COPY --from=build /build/dist /usr/share/nginx/html
